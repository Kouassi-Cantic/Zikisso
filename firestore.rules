rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonction utilitaire pour vérifier si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }

    // Fonction utilitaire pour vérifier si l'utilisateur connecté est administrateur
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "teletechnologyci@gmail.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    // Collection des profils utilisateurs
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Collection des soumissions de devoirs/travaux (accessible pour consultation, correction et évaluation par les pairs)
    match /submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.uid == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.uid == request.auth.uid || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['peerReviewsCount', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.uid == request.auth.uid || 
        isAdmin()
      );
    }

    // Collection de l'Évaluation par les Pairs (Peer-Reviewing pédagogique)
    match /peerReviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.reviewerUid == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.reviewerUid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.reviewerUid == request.auth.uid || isAdmin());
    }

    // Collection des tentatives de quiz
    match /quizAttempts/{attemptId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.uid == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.uid == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.uid == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Collection des attestations / certificats (lecture publique pour le registre de vérification)
    match /certificates/{certificateId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.uid == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Modules et semaines du MOOC (lecture pour tout utilisateur authentifié)
    match /weeks/{weekId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /examFinal/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Collection des signatures de la Charte d'Engagement Civique
    match /charterSignatures/{signatureId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        resource.data.uid == request.auth.uid
      );
    }

    match /moduleBonus/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /glossary/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /toolboxResources/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
